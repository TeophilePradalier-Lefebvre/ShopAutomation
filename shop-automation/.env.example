# Copy to .env (never committed) and adjust for your machine.
# The defaults work out of the box: the suite needs no variable at all.
# The project does not bundle dotenv: load the file with Node itself, e.g.
#   node --env-file=.env server.js
#   node --env-file=.env scripts/run-parallel.js --workers 3
# Any variable can also be exported in the shell or set in a CI job.

# Port of the application under test (server.js). Cypress derives its baseUrl from it
# when you pass CYPRESS_BASE_URL, otherwise cypress.config.js uses 3000.
PORT=3000

# Optional override of the baseUrl used by Cypress (same origin as the API).
# CYPRESS_BASE_URL=http://localhost:3000

# Parallel runner: first worker port and number of workers.
# Worker i uses BASE_PORT + i (3100, 3101, ...), each with its own in-memory store.
BASE_PORT=3100
WORKERS=2

# Video and screenshots on failure are configured in cypress.config.js, not here.
